{
  "name": "adonis-starter-kit",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev --ui=tui",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "@julr/tooling-configs": "^6.4.0",
    "@types/node": "~26.6.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.21.0"
}
